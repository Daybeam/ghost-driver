# ghost-driver-mcp configuration example
# Copy to .env and adjust values. All fields are optional.

# ── Browser ────────────────────────────────────────────────────────────────────
# Stealth mode (anti-bot fingerprint injection)
# Default: false — opt-in only. Enable only for sites you are authorized to automate.
GHOST_STEALTH=false

# Viewport defaults
GHOST_VIEWPORT_WIDTH=1280
GHOST_VIEWPORT_HEIGHT=720

# ── External Tools ─────────────────────────────────────────────────────────────
# FFmpeg binary path (default: "ffmpeg" via PATH lookup)
# GHOST_FFMPEG_PATH=/usr/bin/ffmpeg

# ── VLM (Vision Language Model) ───────────────────────────────────────────────
# Provider: gemini (default), openai, anthropic
GHOST_VLM_PROVIDER=gemini

# API key — provider-specific env var is used as fallback:
#   gemini    → GEMINI_API_KEY
#   openai    → OPENAI_API_KEY
#   anthropic → ANTHROPIC_API_KEY
# GHOST_VLM_API_KEY=your-api-key-here

# Model name (defaults per provider):
#   gemini    → gemini-2.0-flash-exp
#   openai    → gpt-4o
#   anthropic → claude-3-5-sonnet-20241022
# GHOST_VLM_MODEL=gemini-2.0-flash-exp

# Base URL (defaults per provider, override for proxies/Azure/etc):
#   gemini    → https://generativelanguage.googleapis.com/v1beta/models
#   openai    → https://api.openai.com/v1
#   anthropic → https://api.anthropic.com/v1
# GHOST_VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# ── Edition / Toolset Selection ────────────────────────────────────────────────
# Controls which tools are exposed via tools/list.
#
# Presets:
#   base  (default) — browser automation tools only (no UI measurement)
#   dev   / all     — base + UI measurement/inspection tools for frontend dev
#   minimal         — smallest viable set (basic,navigation,interaction,extract,page)
#
# Custom: comma-separated list of toolset names:
#   basic,navigation,interaction,content,extract,page,advanced,auth,form,replay,dev
#
# GHOST_TOOLSETS=base
# GHOST_TOOLSETS=dev
# GHOST_TOOLSETS=minimal

# ── Legacy Tools ───────────────────────────────────────────────────────────────
# Set to 1 to keep old individual tools (get_text, get_markdown, get_html,
# get/set/remove_local_storage, get/set/remove_session_storage) alongside
# the new consolidated tools (get_content, read/write/remove_storage).
# GHOST_LEGACY_TOOLS=1

# ── Storage ────────────────────────────────────────────────────────────────────
# Topology SQLite DB path (default: <binary_dir>/memory/topology.db)
# GHOST_TOPOLOGY_DB=/var/lib/ghost-driver/topology.db

# ── Auth & Identity ───────────────────────────────────────────────────────────
# User identity for the topology database (default: "local_user").
# GHOST_USER_ID=local_user
# API key for cloud reporting (optional, standalone runs without it).
# GHOST_API_KEY=

# ── Debug ──────────────────────────────────────────────────────────────────────
# Enable debug logging to a file (empty = disabled)
# GHOST_DRIVER_DEBUG_LOG=/tmp/ghost-driver-debug.log

# Audit log file for persistent tool call records.
# Enabled by default at ./memory/audit.jsonl. Override path or set empty to disable.
# GHOST_AUDIT_LOG=/var/log/ghost-driver-audit.jsonl

# ── Mouse Tuning ──────────────────────────────────────────────────────────────
# GHOST_MOUSE_JITTER=4.0
# GHOST_MOUSE_STEPS=20
# GHOST_MOUSE_STEP_DELAY=8ms
# GHOST_CLICK_HOLD=40ms
# GHOST_TYPING_DELAY=50ms

# ── Wait Conditions ───────────────────────────────────────────────────────────
# GHOST_MAX_WAIT=15s
# GHOST_NET_IDLE=500ms
# GHOST_DOM_QUIET=300ms
# GHOST_VIS_HASH=400ms
